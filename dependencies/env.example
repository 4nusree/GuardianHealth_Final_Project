# Copy this file to .env and fill in your values before running locally.
# Never commit .env to version control — it contains secrets.
#
# IMPORTANT: Use single quotes around values that contain special characters
# like $ % @ — single quotes prevent the shell/dotenv from treating $ as a
# variable reference, which would silently corrupt your connection string.

# Supabase direct PostgreSQL connection string
# Found in: Supabase Dashboard → Settings → Database → Connection string → URI
SUPABASE_DB_URL='postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres'

# Supabase service role key (bypasses Row Level Security)
# Found in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY='eyJ...'

# Secret used to sign JWTs — change this to a long random string in production
JWT_SECRET='change-me-before-production'
